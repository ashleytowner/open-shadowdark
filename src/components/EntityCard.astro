---
import { type CollectionEntry } from 'astro:content'
import { getEntityType } from '../util/getEntityType';

type Props = CollectionEntry<'entity'>;

const entity = Astro.props;
const url = `/${entity.id}`;
const type = getEntityType(entity);
---
<a href={url} class="grid w-full grid-cols-3 p-4 border-b hover:bg-gray-200 transition-colors no-underline">
	<span class="font-bold">{entity.data.title}</span>
	<span class="text-gray-700 italic">{type}</span>
	<span class="text-gray-700 italic text-right">{entity.data.source}</span>
</a>
