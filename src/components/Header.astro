---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import { Image } from "astro:assets";
import Logo from "../assets/open-sd.png";
---

<header>
	<nav class="w-full flex justify-between p-4 border-b relative">
		<h2>
			<a href="/"
				><span class="sr-only">{SITE_TITLE}</span><Image
					class="m-auto"
					width={30}
					height={30}
					src={Logo}
					alt="Blue wizard hat"
					priority
				/></a
			>
		</h2>
		<form class="group" hx-get="/api/search" hx-target="#results" hx-select="#search-results">
			<label for="search" class="sr-only">Search</label>
			<input
				type="search"
				name="q"
				placeholder="Search..."
				class="border-2 px-4 py-1 w-2/3"
			/>
			<input type="hidden" name="limit" value="5" />
			<div
				class="invisible group-focus-within:visible absolute top-[100%] left-[50%] translate-x-[-50%] bg-white border-2 w-full md:w-1/2"
				id="results"
			>
			</div>
		</form>
		<div class="flex gap-2">
			<HeaderLink href="/">Home</HeaderLink>
		</div>
	</nav>
</header>
